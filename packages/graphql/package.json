{
  "name": "@knead-js/graphql",
  "version": "0.4.0",
  "description": "Code-first GraphQL server with subscriptions over WebSocket for Knead, the NestJS-style web framework for Bun",
  "keywords": [
    "bun",
    "bunjs",
    "bun-framework",
    "knead",
    "web-framework",
    "http-framework",
    "typescript",
    "graphql",
    "graphql-server",
    "code-first",
    "subscriptions",
    "websocket",
    "graphql-ws",
    "dataloader",
    "leaven",
    "api"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/graphql/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/graphql"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "dependencies": {
    "@leaven-graphql/core": "0.2.3",
    "@leaven-graphql/errors": "0.2.1",
    "@leaven-graphql/playground": "0.2.2",
    "@leaven-graphql/ws": "0.2.3",
    "@standard-schema/spec": "^1.1.0",
    "dataloader": "2.2.3"
  },
  "peerDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^",
    "@knead-js/rate-limit": "workspace:^",
    "@knead-js/security-headers": "workspace:^",
    "@knead-js/testing": "workspace:^",
    "graphql": "^16.14.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
