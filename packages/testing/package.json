{
  "name": "@knead/testing",
  "version": "0.0.0",
  "description": "Testing utilities for Knead applications",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "peerDependencies": {
    "@knead/core": "workspace:^",
    "@knead/http": "workspace:^"
  },
  "devDependencies": {
    "@knead/core": "workspace:^",
    "@knead/http": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
