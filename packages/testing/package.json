{
  "name": "@knead-js/testing",
  "version": "0.6.0",
  "description": "Testing utilities with real ephemeral servers for Knead, the NestJS-style web framework for Bun",
  "keywords": [
    "bun",
    "bunjs",
    "bun-framework",
    "knead",
    "web-framework",
    "http-framework",
    "typescript",
    "testing",
    "test",
    "bun-test",
    "integration-testing",
    "e2e",
    "mocking"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/testing/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "peerDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^"
  },
  "devDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
