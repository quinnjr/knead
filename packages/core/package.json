{
  "name": "@knead-js/core",
  "version": "0.3.0",
  "description": "Dependency injection, modules and lifecycle hooks with TC39 decorators for Knead, the NestJS-style web framework for Bun",
  "keywords": [
    "bun",
    "bunjs",
    "bun-framework",
    "knead",
    "web-framework",
    "http-framework",
    "typescript",
    "framework",
    "nestjs",
    "nestjs-alternative",
    "dependency-injection",
    "di",
    "ioc",
    "inversion-of-control",
    "decorators",
    "tc39-decorators",
    "modules",
    "lifecycle",
    "backend"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/core/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./src/polyfill.ts",
    "./src/copy-guard.ts",
    "./dist/polyfill.js",
    "./dist/copy-guard.js"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
