{
  "name": "@knead-js/logging",
  "version": "0.5.0",
  "description": "JSON structured logging with credential redaction for Knead, the NestJS-style web framework for Bun",
  "keywords": [
    "bun",
    "bunjs",
    "bun-framework",
    "knead",
    "web-framework",
    "http-framework",
    "typescript",
    "logging",
    "logger",
    "json-logger",
    "structured-logging",
    "json",
    "observability"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/logging/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/logging"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "peerDependencies": {
    "@knead-js/core": "workspace:^"
  },
  "devDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^",
    "@knead-js/testing": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
