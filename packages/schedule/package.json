  },
  "devDependencies": {
    "@knead-js/core": "workspace:^",
    "@knead-js/http": "workspace:^",
    "@knead-js/testing": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "croner": "10.0.1"
  }
}
