    "cron-jobs",
    "jobs",
    "interval",
    "timeout",
    "distributed-lock",
    "redis"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/schedule/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/schedule"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
