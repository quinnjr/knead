{
  "name": "@knead-js/sanitize",
  "version": "0.3.0",
  "description": "Allowlist HTML sanitization as a Standard Schema wrapper for Knead, the NestJS-style web framework for Bun",
  "keywords": [
    "bun",
    "bunjs",
    "bun-framework",
    "knead",
    "web-framework",
    "http-framework",
    "typescript",
    "sanitize",
    "sanitize-html",
    "html",
    "xss",
    "security",
    "standard-schema",
    "validation"
  ],
  "homepage": "https://quinnjr.github.io/knead/packages/sanitize/",
  "bugs": {
    "url": "https://github.com/quinnjr/knead/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/knead.git",
    "directory": "packages/sanitize"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
