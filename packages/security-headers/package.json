{
  "name": "@hpmws/security-headers",
  "version": "0.0.0",
  "description": "Secure-by-default HTTP security headers (CSP, HSTS, …) for the hpmws framework",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/copy-licenses.ts"
  },
  "dependencies": {
    "@hpmws/core": "workspace:^",
    "@hpmws/http": "workspace:^"
  },
  "devDependencies": {
    "@hpmws/testing": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
