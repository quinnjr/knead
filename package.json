{
  "name": "knead-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p site/tsconfig.snippets.json",
    "test": "pnpm -r test && bun test scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "rm -rf packages/*/dist packages/*/.tsbuildinfo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:pack": "bun scripts/check-pack.ts",
    "trust:npm": "bash scripts/trust-npm-publishers.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
