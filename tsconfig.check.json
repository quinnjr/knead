{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src",
    "examples/*/test",
    "examples/*/scripts",
    "scripts"
  ],
  "exclude": ["**/node_modules", "packages/prisma/test/fixtures/generated"]
}
